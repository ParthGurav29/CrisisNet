+package com.offlineprotocol.ble
+
+import com.offlineprotocol.mesh.MeshAdvertisementData
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.UUID
+import java.util.zip.CRC32
+
+/**
+ * CrisisNet-specific BLE discovery: dedicated service UUID + compact signed advertisement
+ * payload. Peers without a valid payload are not mesh candidates (hardware ScanFilter +
+ * post-parse validation).
+ */
+object CrisisNetBleDiscovery {
+    /** Dedicated CrisisNet mesh discovery / service-data UUID (not Nordic UART). */
+    val SERVICE_UUID: UUID = UUID.fromString("C4A2F9E1-8B5C-4D3A-9F2E-0C7D8E9F1A2B")
+
+    private val CRC_SALT = "CrisisNet-BLE-Mesh-v1".toByteArray(Charsets.UTF_8)
+
+    private const val SERVICE_PAYLOAD_LENGTH = 10
+    private const val MAGIC_A: Byte = 0x43 // 'C'
+    private const val MAGIC_B: Byte = 0x4E // 'N'
+    /** Format of bytes [0..9]; bump if layout changes. */
+    private const val CRISIS_ADV_FORMAT = 1
+
+    fun buildServicePayload(mesh: MeshAdvertisementData): ByteArray {
+        val out = ByteArray(SERVICE_PAYLOAD_LENGTH)
+        out[0] = MAGIC_A
+        out[1] = MAGIC_B
+        out[2] = ((CRISIS_ADV_FORMAT shl 4) or (mesh.featureFlags and 0x0F)).toByte()
+        out[3] = mesh.version.toByte()
+        val hash32 = (mesh.nodeIdHash and 0xFFFF_FFFFL).toInt()
+        val hb = ByteBuffer.allocate(4).order(ByteOrder.BIG_ENDIAN).putInt(hash32).array()
+        System.arraycopy(hb, 0, out, 4, 4)
+        val crc = crc16Of(out, 0, 8)
+        out[8] = ((crc ushr 8) and 0xFF).toByte()
+        out[9] = (crc and 0xFF).toByte()
+        return out
+    }
+
+    fun validateServicePayload(raw: ByteArray?): CrisisNetAdvValidated? {
+        if (raw == null || raw.size < SERVICE_PAYLOAD_LENGTH) return null
+        if (raw[0] != MAGIC_A || raw[1] != MAGIC_B) return null
+        val format = (raw[2].toInt() and 0xFF) ushr 4
+        if (format != CRISIS_ADV_FORMAT) return null
+        val featureNibble = raw[2].toInt() and 0x0F
+        val meshProto = raw[3].toInt() and 0xFF
+        if (meshProto != MeshAdvertisementData.CURRENT_VERSION) return null
+        val expect = crc16Of(raw, 0, 8)
+        val got = ((raw[8].toInt() and 0xFF) shl 8) or (raw[9].toInt() and 0xFF)
+        if (expect != got) return null
+        val nodeLo = ByteBuffer.wrap(raw, 4, 4).order(ByteOrder.BIG_ENDIAN).int.toLong() and 0xFFFF_FFFFL
+        return CrisisNetAdvValidated(
+            meshProtoVersion = meshProto,
+            featureFlagsNibble = featureNibble,
+            nodeIdHashLo = nodeLo,
+        )
+    }
+
+    fun toMeshAdvertisement(validated: CrisisNetAdvValidated, observedRssi: Int?): MeshAdvertisementData {
+        val flags = (MeshAdvertisementData.FEATURE_SCORE_BASED or (validated.featureFlagsNibble and 0x0F)).coerceIn(0, 255)
+        return MeshAdvertisementData(
+            version = validated.meshProtoVersion,
+            degree = 0,
+            freeSlotEstimate = 0,
+            nodeScore = Double.NaN,
+            uptimeSeconds = 0L,
+            batteryPercent = null,
+            loadPercent = null,
+            rssiToYou = observedRssi,
+            nodeIdHash = validated.nodeIdHashLo,
+            featureFlags = flags,
+        )
+    }
+
+    private fun crc16Of(data: ByteArray, offset: Int, len: Int): Int {
+        val c = CRC32()
+        c.update(data, offset, len)
+        c.update(CRC_SALT)
+        val v = c.value.toInt()
+        return (v ushr 16) xor (v and 0xFFFF) and 0xFFFF
+    }
+}
+
+data class CrisisNetAdvValidated(
+    val meshProtoVersion: Int,
+    val featureFlagsNibble: Int,
+    val nodeIdHashLo: Long,
+)
