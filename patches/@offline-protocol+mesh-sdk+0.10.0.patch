+    private fun manufacturerSpecificDataDigest(scanRecord: android.bluetooth.le.ScanRecord?): String {
+        val sa = scanRecord?.manufacturerSpecificData ?: return ""
+        if (sa.size() == 0) return ""
+        val parts = mutableListOf<String>()
+        val lim = min(4, sa.size())
+        for (i in 0 until lim) {
+            val cid = sa.keyAt(i)
+            val blob = sa.valueAt(i)
+            val hex = blob?.toBleHexLine(36) ?: ""
+            parts.add(String.format(Locale.US, "cid=0x%04x:%s", cid and 0xFFFF, hex))
+        }
+        if (sa.size() > lim) {
+            parts.add("+${sa.size() - lim}more")
+        }
+        return parts.joinToString("|")
     }
 
