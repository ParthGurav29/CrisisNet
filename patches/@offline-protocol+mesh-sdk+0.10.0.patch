+package com.offlineprotocol.ble
+
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.UUID
+
+object CrisisNetBleDiscovery {
+
+    val SERVICE_UUID: UUID =
+        UUID.fromString("c4a2f9e1-8b5c-4d3a-9f2e-0c7d8e9f1a2b")
+
+    fun buildServicePayload(
+        meshData: ByteArray,
+        roleTieU16: Int,
+    ): ByteArray {
+        val payload = ByteBuffer
+            .allocate(10)
+            .order(ByteOrder.LITTLE_ENDIAN)
+
+        payload.put(0x01) // version
+
+        payload.putShort(roleTieU16.toShort())
+
+        val copyLen = minOf(meshData.size, 7)
+        payload.put(meshData, 0, copyLen)
+
+        while (payload.position() < 10) {
+            payload.put(0)
+        }
+
+        return payload.array()
+    }
+}
